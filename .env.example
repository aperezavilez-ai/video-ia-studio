# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_ENV=development

# Database
# Local Postgres (desarrollo):
# DATABASE_URL=postgresql://videoai:videoai123@localhost:5432/videoai_studio
# Túnel SSH al DB dedicado del VPS (recomendado para backend SQLAlchemy):
#   ssh -L 5433:127.0.0.1:5432 root@135.181.32.82 -N
#   (requiere publicar 127.0.0.1:5432 del contenedor video-ia-studio-db)
DATABASE_URL=postgresql://postgres:TU_SUPABASE_PASSWORD@127.0.0.1:5433/postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=TU_SUPABASE_PASSWORD
POSTGRES_DB=postgres

# Supabase GafCore (instancia dedicada de ESTE proyecto — no mezclar con Gateway)
SUPABASE_URL=https://supabase.gafcore.com/video-ia-studio
NEXT_PUBLIC_SUPABASE_URL=https://supabase.gafcore.com/video-ia-studio
SUPABASE_ANON_KEY=TU_ANON_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# Redis
REDIS_URL=redis://localhost:6379/0

# Gafcore Gateway AI Service (LLM — distinto de Supabase)
GAFCORE_GATEWAY_URL=https://gafcore-gateway.vercel.app/api/openai/v1
GAFCORE_API_KEY=tu-llave-gafcore
GAFCORE_DEFAULT_MODEL=gpt-5.6-luna

# ComfyUI
COMFYUI_HOST=localhost
COMFYUI_PORT=8188
COMFYUI_API_URL=http://localhost:8188

# Storage
STORAGE_PATH=./storage
MODELS_PATH=./models

# Security
SECRET_KEY=change-this-to-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
